[Unit]
Description=Synthetic Toll-Gate RTSP Publisher Supervisor
After=network-online.target docker.service
Wants=docker.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/synthetic-rtsp
ExecStart=/usr/bin/python3 /opt/synthetic-tollgate/jetson/publish-streams.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synthetic-rtsp

# Security hardening
NoNewPrivileges=false
ProtectSystem=full
ReadWritePaths=/var/log/synthetic-rtsp

[Install]
WantedBy=multi-user.target

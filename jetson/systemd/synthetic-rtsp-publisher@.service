[Unit]
Description=Synthetic RTSP Publisher: %i
After=network-online.target synthetic-rtsp.service
Requires=mediamtx.service

[Service]
Type=simple
Environment=STREAM_NAME=%i
Environment=STREAM_CONFIG=/opt/synthetic-tollgate/jetson/streams.yaml
Environment=DATA_DIR=/opt/synthetic-tollgate/jetson/data

ExecStart=/usr/bin/python3 -c "
import sys, json, subprocess, signal, yaml
from pathlib import Path

config_path = Path('\$STREAM_CONFIG')
with open(config_path) as f:
    streams = yaml.safe_load(f).get('streams', [])
stream = next((s for s in streams if s['name'] == '\$STREAM_NAME'), None)
if not stream:
    sys.exit(1)

source = Path(stream['source'])
if not source.is_file():
    sys.exit(2)

cmd = [
    'ffmpeg', '-re', '-ss', str(stream.get('offset_seconds', 0)),
    '-i', str(source), '-stream_loop', '-1',
    '-c:v', 'copy', '-an',
    '-f', 'rtsp', '-rtsp_transport', 'tcp',
    f'rtsp://127.0.0.1:8554/{stream[\"name\"]}'
]

proc = subprocess.Popen(cmd)
def handle_signal(signum, frame):
    proc.terminate()
    proc.wait()
    sys.exit(0)

signal.signal(signal.SIGTERM, handle_signal)
signal.signal(signal.SIGINT, handle_signal)
proc.wait()
sys.exit(proc.returncode)
"
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synthetic-rtsp-%i

[Install]
WantedBy=multi-user.target
